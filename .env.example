# Copy to .env. The app, `npm test` and the mock provider work without any key.

# Jev by TypeSafe AI: the main classifier ("jev" provider, `npm run eval -- --provider jev`).
# Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# Optional: pin another Jev version (default jev-1.14.0)
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Only for the "llm" comparison provider, `npm run eval -- --provider llm` and `npm run test:live`.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# PORT=8787
